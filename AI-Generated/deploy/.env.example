# -----------------------------------------------------------------------
# Copy this file to .env in the deploy/ directory and fill in all values.
# Never commit .env to version control.
# -----------------------------------------------------------------------

# Postgres
POSTGRES_USER=yomitourney
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=yomitourney

# API
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
STEAM_PUBLISHER_KEY=CHANGE_ME_YOUR_STEAM_WEB_API_KEY
SUPPORTED_GAME_VERSIONS=1.9.20-steam
REPLAY_MAX_SIZE_MB=50
LOG_LEVEL=info

# Storage: "local" writes to the replay_storage Docker volume.
# Switch to "s3" and fill the S3_* vars to migrate to cloud storage.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
